<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/home_widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@android:color/transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/home_widget_row_heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFD8C2EA" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/home_widget_row_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="0dp" android:textColor="#D0F7F3FA" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/home_widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end" android:textColor="#FFF7F3FA" android:textSize="15sp" />
    <TextView android:id="@+id/home_widget_row_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end" android:textColor="#DBF7F3FA" android:textSize="12sp" />
</LinearLayout>
